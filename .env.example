# ============================================================
# XRAY GEMINI BROWSER AUDIT - EXAMPLE CONFIGURATION
# Copy to .env and keep private. Never commit your VLESS/sub URL.
# ============================================================

# Mode: "vless" tests ONE connection on listed ports.
# Mode: "subscription" tests EACH supported VLESS link at its own port.
MODE=vless

# Your full VLESS link (leave it blank in this public template).
VLESS_URL=

# Inclusive ranges, separated by commas. Used only when MODE=vless.
PORTS=21001-21009,22001-22010,23001-23008,24001-24009,25001-25025

# For MODE=subscription: HTTPS subscription containing plain or base64 VLESS URLs.
# Not used when MODE=vless.
SUBSCRIPTION_URL=

# ============================================================
# TEST SETTINGS - built-in recommended defaults
# ============================================================
RETRIES=3
# Only after prompt is submitted; raise to 50-90 for Gemini Pro.
ANSWER_WAIT=70
TIMEOUT=55
# Total seconds for BOTH page navigation and textbox readiness.
READY_WAIT=15
RESPONSE_STABLE=4
RETRY_DELAY=7
PAUSE=8

# ============================================================
# CHROME / XRAY / OUTPUT
# ============================================================
# First open ordinary Chrome without Xray/proxy for Google sign-in.
# Set false to skip direct login if the local profile is already authenticated.
LOGIN_DIRECT=true

# Automatically close ONLY the dedicated test Chrome after
# completing / interrupting tests. The login profile is retained.
CLOSE_BROWSER=true

# Leave CHROME_PATH empty to auto-detect google-chrome.
CHROME_PATH=
PROFILE_DIR=.local/browser-profile
OUTPUT_DIR=reports/session
SOCKS_PORT=18998

# Official Xray Docker image; Xray is not installed on the host.
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.3.27
XRAY_STARTUP_TIMEOUT=20

# Command-line arguments override values in this .env file.
# This tool tests Gemini Web, not necessarily Gemini Android.
