# Copy to .env; .env is ignored by Git. Never commit your actual proxy links.
#
# MODE=vless: change only the port of ONE VLESS URL.
# MODE=subscription: fetch all URI entries and use each one's own host and port.
MODE=vless
VLESS_URL=
PORTS=21001-21009,22001-22010,23001-23008,24001-24009,25001-25025

# For subscription mode, set MODE=subscription and provide:
SUBSCRIPTION_URL=

# Supported subscription format: newline-delimited VLESS URI links or
# a base64-encoded text list. Non-VLESS links are reported as skipped.
# Clash YAML / JSON, VMess, Trojan, Shadowsocks and complex transports
# (XHTTP/gRPC/WS) are NOT supported by this version.

# Browser audit settings (defaults; CLI flags override these).
# RETRIES: retry uncertain/error outcomes at least 3 times.
# ANSWER_WAIT: seconds to wait for Gemini's model response.
RETRIES=3
ANSWER_WAIT=70
